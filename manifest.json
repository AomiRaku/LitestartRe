{
  "manifest_version": 3,
  "name": "Litestart",
  "version": "1.2.0",
  "minimum_chrome_version": "109",
  "description": "可定制的类原生浏览器起始页",
  
  "chrome_url_overrides": {
    "newtab": "index.html"
  },

  "web_accessible_resources": [
    {
      "resources": ["img/*"],
      "matches": ["<all_urls>"]
    }
  ],

  "host_permissions": [
    "https://bing.biturl.top/",
    "https://api.xinac.net/*",
    "https://suggestion.baidu.com/*",
    "https://suggestqueries.google.com/*"
  ],

  "icons": {
    "16": "img/icon.png",
    "48": "img/icon.png",
    "128": "img/icon.png"
  }
}